# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

.idea
/market-services

# Editor/IDE
# .idea/
# .vscode/

# Node
frontend/node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/
.vercel/
frontend/.vercel/
node_modules/
dist/

# Logs
*.log

# Local secrets and machine state. Examples/templates remain reviewable.
.env
.env.*
**/.env
**/.env.*
*.env
*.env.*
.envrc
.envrc.*
**/.envrc
**/.envrc.*
env.sh

*.pem
*.key
*.p12
*.pfx
*.jks
*.seed
*.mnemonic
*.tss-share
**/tss/**/*share*
wallet.dat
wallet.json
wallet-state*
wallet_state*
keystore.json
keystore/
**/keystore/
UTC--*
*.db
*.sqlite
*.sqlite3
*.mdb
*.ldb
*.rdb
*.dump
*.backup
*.tfstate
*.tfstate.*
pgdata/
postgres-data/
secrets/
**/secrets/
.npmrc
.pypirc
.netrc
credentials.json
service-account.json
service_account.json
kubeconfig

!**/.env*.example
!**/.env*.template
!**/*.env*.example
!**/*.env*.template
!**/*.example
!**/*.example.*
!**/*.template
!**/*.template.*

# Build binaries
market-services-bin
market-services-test

# Vite cache
frontend/node_modules/.vite/

# macOS metadata
.DS_Store
**/.DS_Store

# Personal interview notes kept outside engineering commits
docs/Golang_interview.txt
docs/project-go-interview-bagua.md
