# Copy this file to:
#   ~/Library/Application Support/Qiu Market/production.env
# Keep the resulting file mode at 0600 and never commit it.

MARKET_HTTP_HOST=127.0.0.1
MARKET_HTTP_PORT=9092
MARKET_RPC_HOST=127.0.0.1
MARKET_RPC_PORT=9091
MARKET_TRADING_GRPC_ADDR=127.0.0.1:9094
MARKET_TRADING_LOCAL_AUTH=false
MARKET_TRADING_SECURE_COOKIES=true
MARKET_TRADING_ALLOWED_ORIGINS=https://qiu-market.vercel.app
MARKET_TRADING_DEMO_MAKER_ENABLED=true
# Private runtime secret, generated outside the repository. Format:
# key_id:unpadded-base64url-secret (at least 32 decoded bytes).
MARKET_TRADING_CURSOR_HMAC_CURRENT=replace-with-private-key-id-and-base64url-secret
# Keep only during a bounded key-rotation window; otherwise leave empty.
MARKET_TRADING_CURSOR_HMAC_PREVIOUS=
# Keep false until the Recovery Coordinator operator workflow has created and
# promoted a durable epoch. Enabling it without that workflow intentionally
# leaves submit/cancel/fund fail-closed.
MARKET_TRADING_RECOVERY_GATE_ENABLED=false
# Recovery provenance is fail-closed. Populate the first four values only from
# the exact promoted artifacts. Leave SOURCE_DIGEST empty so the process hashes
# its current executable; if release automation supplies it, startup verifies
# exact equality and refuses a stale value. Never copy historical values.
MARKET_TRADING_PRODUCTION_ORIGIN=
MARKET_TRADING_DEPLOYMENT_ID=
MARKET_TRADING_DEPLOYMENT_URL=
MARKET_TRADING_RELEASE_COMMIT=
# Optional assertion; empty means derive the current executable SHA-256.
MARKET_TRADING_SOURCE_DIGEST=
MARKET_DEX_PUBLIC_FALLBACK=true
MARKET_DORIS_HOST=
MARKET_FUNNEL_ORIGIN=https://xiuqiudemac-mini.tail2e4386.ts.net
# auto inherits an active local macOS HTTPS proxy (for example Clash Verge)
# without proxying loopback API, gRPC, PostgreSQL, or Redis traffic.
# Use off only when this Mac has reliable direct Internet connectivity.
QIU_MARKET_SYSTEM_PROXY=auto
# Override legacy repository values when the local Redis has no password.
MARKET_REDIS_PASSWORD=

# Use the same high-entropy value in Vercel's S78_PROXY_HMAC_SECRET.
MARKET_PUBLIC_PROXY_HMAC_SECRET=replace-with-a-random-secret

# Create a GitHub OAuth App and keep these values only in the private file.
MARKET_TRADING_GITHUB_CLIENT_ID=replace-with-github-client-id
MARKET_TRADING_GITHUB_CLIENT_SECRET=replace-with-github-client-secret
MARKET_TRADING_GITHUB_REDIRECT_URL=https://qiu-market.vercel.app/api/v1/trading/auth/github/callback
