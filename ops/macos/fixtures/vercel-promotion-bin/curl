#!/usr/bin/env bash
set -euo pipefail

output_file=""
header_file=""
request_url=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --output)
      output_file="$2"
      shift 2
      ;;
    --dump-header)
      header_file="$2"
      shift 2
      ;;
    --max-time|--write-out|--request|--header|--data)
      shift 2
      ;;
    --silent|--show-error)
      shift
      ;;
    http*)
      request_url="$1"
      shift
      ;;
    *)
      shift
      ;;
  esac
done

current_production_id="$(
  jq -r '.production_id' "${QIU_MARKET_FIXTURE_VERCEL_STATE:?}"
)"
if [ "${QIU_MARKET_FIXTURE_PRODUCTION_FAIL:-0}" = 1 ] &&
  [ "$current_production_id" = "${QIU_MARKET_FIXTURE_CANDIDATE_ID:?}" ] &&
  [[ "$request_url" == *"/api/v1/trading/markets/BTC-USDT/status" ]]; then
  printf '{"state":"failed"}\n' > "$output_file"
  printf 'HTTP/2 503\r\ncontent-type: application/json\r\n\r\n' > "$header_file"
  printf '503'
  exit 0
fi

case "$request_url" in
  */api/v1/trading/markets/BTC-USDT/status)
    printf '{"state":"ready","last_error":"","outbox_state":"ready","outbox_last_error":""}\n' \
      > "$output_file"
    {
      printf 'HTTP/2 200\r\n'
      printf 'X-Qiu-Market-Provenance: VERIFIED\r\n'
      printf 'X-Qiu-Market-Deployment-ID: %s\r\n' "${QIU_MARKET_FIXTURE_CANDIDATE_ID:?}"
      printf 'X-Qiu-Market-Deployment-URL: https://%s\r\n' "${QIU_MARKET_FIXTURE_CANDIDATE_HOST:?}"
      printf 'X-Qiu-Market-Release-Commit: %s\r\n' "${QIU_MARKET_FIXTURE_COMMIT:?}"
      printf '\r\n'
    } > "$header_file"
    printf '200'
    ;;
  */api/v1/trading/auth/capabilities)
    printf '{"github_oauth_enabled":true,"local_login_enabled":false}\n' > "$output_file"
    printf 'HTTP/2 200\r\ncontent-type: application/json\r\n\r\n' > "$header_file"
    printf '200'
    ;;
  */api/v1/trading/auth/github/start)
    encoded="$(
      python3 - <<'PY'
from urllib.parse import urlencode
print(urlencode({
    "redirect_uri": "https://qiu-market.vercel.app/api/v1/trading/auth/github/callback"
}))
PY
    )"
    printf '' > "$output_file"
    {
      printf 'HTTP/2 302\r\n'
      printf 'location: https://github.com/login/oauth/authorize?%s\r\n' "$encoded"
      printf 'set-cookie: s78_trading_oauth_state=fixture; Secure; HttpOnly; SameSite=Lax\r\n'
      printf '\r\n'
    } > "$header_file"
    printf '302'
    ;;
  */api/v1/trading/session)
    printf '{"code":"invalid_session"}\n' > "$output_file"
    printf 'HTTP/2 401\r\ncontent-type: application/json\r\n\r\n' > "$header_file"
    printf '401'
    ;;
  */api/v2/get_market_overview)
    printf '{"code":"invalid_proxy_signature"}\n' > "$output_file"
    printf 'HTTP/2 401\r\ncontent-type: application/json\r\n\r\n' > "$header_file"
    printf '401'
    ;;
  *)
    printf '<!doctype html><title>Qiu Market</title>\n' > "$output_file"
    printf 'HTTP/2 200\r\ncontent-type: text/html\r\n\r\n' > "$header_file"
    printf '200'
    ;;
esac
