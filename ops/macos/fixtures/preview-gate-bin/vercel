#!/usr/bin/env bash
set -euo pipefail

action="${1:-}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "$action" in
  inspect)
    cat <<'JSON'
{
  "id": "dpl_FixturePreview123",
  "url": "qiu-market-fixture-preview.vercel.app",
  "readyState": "READY",
  "target": "preview"
}
JSON
    ;;
  curl)
    endpoint="${1:-}"
    headers_file=""
    body_file=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --dump-header)
          headers_file="$2"
          shift 2
          ;;
        --output)
          body_file="$2"
          shift 2
          ;;
        *)
          shift
          ;;
      esac
    done
    if [ -z "$headers_file" ] || [ -z "$body_file" ]; then
      echo "The fake Vercel curl requires response destinations." >&2
      exit 1
    fi
    status=200
    content_type="text/html; charset=utf-8"
    body='<!doctype html><title>Qiu Market</title>'
    case "$endpoint" in
      /api/v1/trading/markets/BTC-USDT/status)
        content_type="application/json"
        body='{"state":"ready","last_error":"","outbox_state":"ready","outbox_last_error":""}'
        ;;
      /api/v1/trading/auth/capabilities)
        content_type="application/json"
        if [ "${FIXTURE_GITHUB_OAUTH_ENABLED:-0}" = 1 ]; then
          body='{"github_oauth_enabled":true,"local_login_enabled":false}'
        else
          body='{"github_oauth_enabled":false,"local_login_enabled":false}'
        fi
        ;;
      /api/v1/trading/session)
        status=401
        content_type="application/json"
        body='{"code":"unauthorized"}'
        ;;
    esac
    release_commit="2aa8bda39d2298e1d57886e472f9a090d728f56e"
    if [ "${FIXTURE_BAD_PROVENANCE:-0}" = 1 ]; then
      release_commit="0000000000000000000000000000000000000000"
    fi
    printf '%s\r\n' \
      "HTTP/2 $status" \
      "Content-Type: $content_type" \
      'X-Qiu-Market-Provenance: VERIFIED' \
      'X-Qiu-Market-Deployment-ID: dpl_FixturePreview123' \
      'X-Qiu-Market-Deployment-URL: https://qiu-market-fixture-preview.vercel.app' \
      "X-Qiu-Market-Release-Commit: $release_commit" \
      '' > "$headers_file"
    printf '%s\n' "$body" > "$body_file"
    printf '%s' "$status"
    ;;
  *)
    echo "Unsupported fake Vercel command: $action" >&2
    exit 1
    ;;
esac
