#!/usr/bin/env bash
set -euo pipefail

headers_file=""
body_file=""
request_url=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --dump-header)
      headers_file="$2"
      shift 2
      ;;
    --output)
      body_file="$2"
      shift 2
      ;;
    http://*|https://*)
      request_url="$1"
      shift
      ;;
    *)
      shift
      ;;
  esac
done

if [ -z "$headers_file" ] || [ -z "$body_file" ]; then
  echo "The fake Preview curl requires response destinations." >&2
  exit 1
fi

status=302
if [[ "$request_url" == https://fixture-funnel.invalid/* ]]; then
  status=401
fi
printf '%s\r\n' "HTTP/2 $status" '' > "$headers_file"
printf '{}\n' > "$body_file"
printf '%s' "$status"
