{
  "name": "qiu-market",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:functions && vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:gate-lib": "node --test scripts/live-gate-lib.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:golden": "playwright test --config playwright.golden.config.ts",
    "gate:preview-oauth": "node scripts/run-preview-oauth-gate.mjs",
    "gate:production-auth": "node scripts/run-production-auth-gate.mjs",
    "typecheck:functions": "tsc --noEmit -p tsconfig.functions.json"
  },
  "dependencies": {
    "@vercel/functions": "3.7.6",
    "echarts": "^6.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "overrides": {
    "tsx": {
      "esbuild": "^0.28.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.8"
  }
}
