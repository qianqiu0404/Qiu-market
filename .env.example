# S78 Market Services 环境变量模板
# 使用方法：cp .env.example .env
# 以下默认值与项目自带 docker-compose.yml（PostgreSQL 16 + Redis 7）匹配，
# 新设备上执行 make dev-deps 后可直接使用，无需修改。

# 数据库迁移文件目录（默认 ./migrations）
export MARKET_MIGRATIONS_DIR=./migrations

# 主库（docker-compose 中的 postgres 服务，trust 认证，密码可任意填写）
export MARKET_MASTER_DB_HOST=127.0.0.1
export MARKET_MASTER_DB_PORT=5432
export MARKET_MASTER_DB_USER=xiuqiu
export MARKET_MASTER_DB_PASSWORD=postgres
export MARKET_MASTER_DB_NAME=s78_market

# 从库（可选，本地开发留空即可，程序会回退使用主库）
export MARKET_SLAVE_DB_HOST=
export MARKET_SLAVE_DB_PORT=
export MARKET_SLAVE_DB_USER=
export MARKET_SLAVE_DB_PASSWORD=
export MARKET_SLAVE_DB_NAME=

# gRPC 服务
export MARKET_RPC_HOST=127.0.0.1
export MARKET_RPC_PORT=9091

# HTTP API 服务（前端 Vite 代理的目标地址）
export MARKET_HTTP_HOST=127.0.0.1
export MARKET_HTTP_PORT=9092

# 虚拟 BTC/USDT 交易域。撮合服务只监听 loopback 9094，HTTP API 通过
# 本机 gRPC 适配 REST/WebSocket；不连接充值、提现、私钥或真实下单。
export MARKET_TRADING_GRPC_ADDR=127.0.0.1:9094
export MARKET_TRADING_ALLOWED_ORIGINS=http://127.0.0.1:5174
# 本地免 OAuth 必须显式开启，且 MARKET_HTTP_HOST 必须是 IP loopback。
export MARKET_TRADING_LOCAL_AUTH=true
export MARKET_TRADING_SECURE_COOKIES=false
export MARKET_TRADING_DEMO_MAKER_ENABLED=true
# 共享 HTTPS 环境关闭 LOCAL_AUTH，并只在私有 .env 填 OAuth 配置。
export MARKET_TRADING_GITHUB_CLIENT_ID=
export MARKET_TRADING_GITHUB_CLIENT_SECRET=
export MARKET_TRADING_GITHUB_REDIRECT_URL=

# Metrics 服务
export MARKET_METRIC_HOST=127.0.0.1
export MARKET_METRIC_PORT=9093

# Redis（docker-compose 中的 redis 服务，无密码）
export MARKET_REDIS_ADDRESS=127.0.0.1:6379
export MARKET_REDIS_PASSWORD=
export MARKET_REDIS_DB_INDEX=0

# Phase 0 安全门：false 时仍发现并审计四家目录，但只运行现有 Binance
# 正式行情写入。72 小时底座验收通过后才显式切为 true。
export MARKET_MULTI_VENUE_ENABLED=false

# 可选 DEX shadow 端点。真实 RPC / The Graph key 只能放本机 .env，
# 不能提交到仓库；留空时 dex 角色仍运行 Hyperliquid，并将对应 AMM
# 明确标记为 Unconfigured。
export MARKET_ETHEREUM_RPC_URL=
export MARKET_BSC_RPC_URL=
export MARKET_UNISWAP_V3_SUBGRAPH_URL=
export MARKET_PANCAKE_V3_SUBGRAPH_URL=

# Apache Doris OLAP 数仓（可选，docker-compose 中的 doris 服务）
# 以下即程序内置默认值，无需取消注释；只有非默认部署才需要修改。
# Doris 未启动时：make dw 报明确错误拒绝运行，/api/v1/get_kline_analytics 返回标准错误信封，
# 不影响 api / crawler / worker / dex / rpc 的任何既有功能。
# 想彻底禁用数仓（连启动探测都不做）：export MARKET_DORIS_HOST=
# export MARKET_DORIS_HOST=127.0.0.1
# export MARKET_DORIS_HTTP_PORT=8030
# export MARKET_DORIS_QUERY_PORT=9030
# export MARKET_DORIS_USER=root
# export MARKET_DORIS_PASSWORD=
# export MARKET_DORIS_DB=s78_market_dw
